# Copy to .env.local. Never commit .env.local.

# Base URL of the Django API (backend/). Must match PUBLIC_API_URL there, and
# its hostname is allowed automatically in next.config.ts for uploaded images.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the Django -> Next.js revalidation webhook.
# Must match REVALIDATE_SECRET in backend/.env.
REVALIDATE_SECRET=change-me-too

# Optional: the business's own Tawk.to embed URL enables live chat in the
# floating contact button, e.g. https://embed.tawk.to/<property>/<widget>
# NEXT_PUBLIC_TAWK_SRC=
